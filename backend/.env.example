# ── DocMind Configuration ──────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# All settings are read from ONE place: backend/app/config.py

# ── LLM (optional — everything works without it) ──────────────────────
# Set ONE API key.  The provider is auto-detected from whichever key
# you provide.  Or set LLM_PROVIDER explicitly.
#
# LLM_PROVIDER=anthropic          # anthropic | openai | google | groq | mistral | openai_compatible
# LLM_MODEL=                      # auto-detected default per provider if blank

# --- Anthropic Claude ---
# ANTHROPIC_API_KEY=sk-ant-api03-...
# LLM_MODEL=claude-sonnet-4-20250514

# --- OpenAI ---
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o

# --- Google Gemini ---
# GOOGLE_API_KEY=AIza...
# LLM_MODEL=gemini-2.0-flash

# --- Groq ---
# GROQ_API_KEY=gsk_...
# LLM_MODEL=llama-3.3-70b-versatile

# --- Mistral ---
# MISTRAL_API_KEY=...
# LLM_MODEL=mistral-large-latest

# --- Any OpenAI-compatible endpoint (Ollama, LM Studio, vLLM, etc.) ---
# LLM_PROVIDER=openai_compatible
# OPENAI_API_KEY=not-needed        # some endpoints require a dummy key
# OPENAI_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3

# ── Embeddings (free, local — no API key needed) ──────────────────────
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# EMBEDDING_DEVICE=cpu

# ── RAG tuning ─────────────────────────────────────────────────────────
# CHUNK_SIZE=900
# CHUNK_OVERLAP=150
# RETRIEVAL_K=4
# SCORE_THRESHOLD=0.05
